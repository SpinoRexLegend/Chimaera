AUTH_ENABLED=true
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_ISSUER_URI=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWK_SET_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Optional local-development fallback when the backend cannot reach Supabase JWKS.
# Copy kid/x/y from the project's public JWKS document. Never place a private key here.
SUPABASE_JWK_KID=
SUPABASE_JWK_X=
SUPABASE_JWK_Y=
